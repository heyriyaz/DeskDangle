{
  "name": "deskdangle",
  "productName": "DeskDangle",
  "version": "2.0.0",
  "private": true,
  "description": "A playful desktop companion and interactive physics charm for macOS and Windows",
  "keywords": [
    "desktop-pet",
    "companion",
    "physics-engine",
    "matter-js",
    "electron",
    "react",
    "typescript",
    "vite",
    "windows",
    "macos",
    "interactive"
  ],
  "author": "Riyaz (https://github.com/heyriyaz)",
  "license": "MIT",
  "homepage": "https://github.com/heyriyaz/DeskDangle#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyriyaz/DeskDangle.git"
  },
  "bugs": {
    "url": "https://github.com/heyriyaz/DeskDangle/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:msix": "node scripts/build-msix.js",
    "package:store": "node scripts/build-msix.js --store",
    "install:msix": "powershell -ExecutionPolicy Bypass -File ./scripts/install-test-msix.ps1",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "package:dmg": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never",
    "package:zip": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --publish never"
  },
  "build": {
    "appId": "com.deskdangle.desktop",
    "productName": "DeskDangle",
    "copyright": "Copyright © 2026 DeskDangle. All rights reserved.",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.icns",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/tests/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "DeskDangle-${version}-Mac.${ext}"
    },
    "dmg": {
      "title": "DeskDangle ${version}",
      "artifactName": "DeskDangle-${version}-Mac.dmg",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskDangle",
      "artifactName": "DeskDangle-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "DeskDangle ${version}",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    },
    "appx": {
      "artifactName": "DeskDangle-${version}.${ext}",
      "backgroundColor": "#141413",
      "showNameOnTiles": false,
      "identityName": "Riyaz.DeskDangle",
      "publisher": "CN=84CCE9A5-1585-4D4A-A911-F08CBC54D25D",
      "publisherDisplayName": "Riyaz",
      "customManifestPath": "Package.appxmanifest"
    }
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.19.6",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.11"
  }
}
